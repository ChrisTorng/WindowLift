<Window x:Class="WindowLift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowLift"
        Width="700"
        Height="610"
        MinWidth="640"
        MinHeight="570"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="WindowLift" />
      <TextBlock Margin="0,7,0,0"
                 Foreground="#5C5C5C"
                 Text="Keeps oversized dialogs usable without changing their horizontal position or width."
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="14"
            Background="#F4F7FA"
            BorderBrush="#D8DEE6"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Automatic monitoring" />
        <TextBlock Margin="0,5,0,0"
                   Foreground="#5C5C5C"
                   Text="Visible, non-maximized windows are checked at startup and whenever they are activated or moved. Newly opened dialogs are detected automatically."
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <GroupBox Grid.Row="4" Header="Behavior" Padding="14,10,14,14">
      <StackPanel>
        <CheckBox x:Name="TaskbarOverlapCheckBox" IsChecked="True">
          <StackPanel Margin="5,0,0,0">
            <TextBlock FontWeight="SemiBold" Text="Allow over the taskbar" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#666666"
                       Text="Uses the full screen height. An adjusted window stays above the taskbar only while focused; topmost is removed immediately when focus changes."
                       TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>

        <CheckBox x:Name="TitleBarLiftCheckBox" Margin="0,14,0,0" IsChecked="True">
          <StackPanel Margin="5,0,0,0">
            <TextBlock FontWeight="SemiBold" Text="Lift the title bar" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#666666"
                       Text="When a window is too tall, allows nearly one title-bar height beyond the top edge to preserve more content."
                       TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>

        <CheckBox x:Name="ShrinkToFitCheckBox" Margin="0,14,0,0" IsChecked="True">
          <StackPanel Margin="5,0,0,0">
            <TextBlock FontWeight="SemiBold" Text="Shrink the window height" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#666666"
                       Text="Reduces an oversized window until it fits. The target app may add a vertical scrollbar when its layout supports one."
                       TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </GroupBox>

    <StackPanel Grid.Row="6" Orientation="Horizontal">
      <Button x:Name="MonitorButton"
              MinWidth="145"
              Height="36"
              Click="MonitorButton_OnClick"
              Content="Stop monitoring" />
      <Button x:Name="ScanButton"
              Margin="10,0,0,0"
              MinWidth="105"
              Height="36"
              Click="ScanButton_OnClick"
              Content="Scan now" />
    </StackPanel>

    <Border Grid.Row="8" Padding="11" Background="#F4F6F8" CornerRadius="4">
      <TextBlock x:Name="StatusText" Text="Starting…" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
